# xcb-imdkit provides the XIM wire protocol implementation used by the
# xim-server module.  It is LGPL-2.1-only and is linked dynamically; see
# compositor/xim-server.c for the rationale.
#
# Upstream's CMake build requires ECM (KDE Extra CMake Modules), which the WSLg
# build container does not have, so the CMake subproject cannot be configured
# there.  We therefore ship a meson.build for it in
# subprojects/packagefiles/xcb-imdkit/, transcribed from upstream's CMake
# files, and meson applies that directory on top of the fetched sources.
#
# Systems that package the library (Arch: extra/xcb-imdkit) use the system copy
# instead; the fallback only kicks in when dependency('xcb-imdkit') fails.
[wrap-file]
directory = xcb-imdkit
source_url = https://github.com/fcitx/xcb-imdkit/archive/refs/heads/master.tar.gz
source_filename = xcb-imdkit-master.tar.gz
source_hash = b8246da25ae4cba45dba616ee628d1285683fb2dcea0f776fc98442c460fb763
patch_directory = xcb-imdkit
